// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
 
enum RoleType {
  ADMIN
  MANAGER
  ENGNEER
  TECHNICIAN
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LocationType {
  PLANT
  WAREHOUSE
  OFFICE
  FACILITY
  OTHERS
}

enum DepartmentType {
  MECHANICAL
  ELECTRICAL
  INSTRUMENTATION
  CIVIL
  OTHERS
}

enum IndustryType {
  MANUFACTURING
  CHEMICAL
  OIL_GAS
  FERTILIZER
  GENERAL
  OTHERS
}

enum CompanySize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum FrequencyType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ItemStatus {
  PENDING
  OK
  NOT_OK
  SKIPPED
}

enum BreakdownSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreakdownStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  BREAKDOWN_RAISED
  BREAKDOWN_ASSIGNED
  BREAKDOWN_RESOLVED
}

enum ReferenceType {
  TASK
  BREAKDOWN
}

model Organization {
  id                  Int             @id @default(autoincrement())
  name                String
  slug                String          @unique //URL-Friendly unique identifier
  industryType        IndustryType?
  companySize         CompanySize?
  country             String?
  city                String?
  logoUrl             String?
  isActive            Boolean         @default(true)

  users               User[]
  locations           Location[]
  departments         Department[]
  invitations         Invitation[]
  equipmentTypes      EquipmentType[]
  equipments          Equipment[]
  checklistTemplates  ChecklistTemplate[]
  pmSchedules         PMSchedule[]
  pmTasks             PMTask[]
  breakdownReports    BreakdownReport[]
  notifications       Notification[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model User {
  id                      Int                 @id @default(autoincrement())   
  organizationId          Int
  organization            Organization        @relation(fields: [organizationId], references: [id])

  name                    String
  email                   String              @unique
  passwordHash            String
  isEmailVerified         Boolean             @default(false)
  isActive                Boolean             @default(true)
  lastLoginAt             DateTime?

  roles                   UserRole[]
  department              UserDepartment?
  emailVerifications      EmailVerification[]
  passwordResets          PasswordReset[]
  userSession             UserSession[]
  pmSchedules             PMSchedule[]
  pmTasks                 PMTask[]
  reportedBreakdowns      BreakdownReport[]   @relation("ReportedBy")
  assignedBreakdowns      BreakdownReport[]   @relation("AssignedTo")
  breakdownActions        BreakdownAction[]
  notifications           Notification[]

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([organizationId]) //@@ means model level attribute. It applies to the table
}

model Role {
  id        Int           @id @default(autoincrement())
  name      RoleType      @unique
  users     UserRole[]
}

// It's a junction table between user <-> role
model UserRole {
  id        Int   @id @default(autoincrement())
  userId    Int
  roleId    Int

  user      User  @relation(fields: [userId], references: [id])
  role      Role  @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Location {
  id                Int           @id @default(autoincrement())
  organizationId    Int
  organization      Organization  @relation(fields: [organizationId], references: [id])

  name              String
  type              LocationType?
  address           String

  createdAt         DateTime      @default(now())
}

model Department {
  id                Int             @id @default(autoincrement())
  organizationId    Int             
  organization      Organization    @relation(fields: [organizationId], references: [id])

  name              String
  code              String
  type              DepartmentType

  users             UserDepartment[]
  
  createdAt         DateTime        @default(now())
}

model UserDepartment {
  id              Int         @id @default(autoincrement())
  userId          Int         @unique // The unique refer that one user have one department
  departmentId    Int

  user            User        @relation(fields: [userId], references: [id])
  department      Department  @relation(fields: [departmentId], references: [id])
}

model Invitation {
  id                Int                 @id @default(autoincrement())
  organizationId    Int             
  organization      Organization        @relation(fields: [organizationId], references: [id])

  email             String
  roleId            Int 
  departmentId      Int?
  token             String              @unique
  status            InvitationStatus
  expiresAt         DateTime

  role              Role                @relation(fields: [roleId], references: [id])
  department        Department?         @relation(fields: [departmentId], references:[id])

  createdAt         DateTime            @default(now())

  @@unique([organizationId, email])
}

model EmailVerification {
  id          Int       @id @default(autoincrement())
  userId      Int       
  token       String    @unique
  expiresAt   DateTime

  user        User      @relation(fields: [userId], references: [id])

  createdAt   DateTime  @default(now())
}

model PasswordReset {
  id          Int         @id @default(autoincrement())
  userId      Int
  token       String      @unique
  expiresAt   DateTime 

  user        User        @relation(fields: [userId], references: [id])

  createdAt   DateTime    @default(now())
}

model AuditLog {
  id                Int       @id @default(autoincrement())
  organizationId    Int
  userId            Int

  action            String
  module            String
  recordId          String
  ipAddress         String?

  createdAt         DateTime  @default(now())
}

model UserSession {
  id                Int         @id @default(autoincrement())
  userId            Int         

  refreshToken      String      @unique
  deviceInfo        String?
  ipAddress         String?
  userAgent         String?

  isActive          Boolean     @default(true)
  lastActiveAt      DateTime    @default(now())

  createdAt         DateTime    @default(now())
  expiresAt         DateTime

  user              User        @relation(fields: [userId], references: [id])
}

model EquipmentType {
  id                Int             @id @default(autoincrement())
  organizationId    Int
  organization      Organization    @relation(fields: [organizationId], references: [id])

  name              String
  code              String?      
  description       String?

  isActive          Boolean         @default(true)

  equipments        Equipment[]


  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, name]) // Inside one organization type name is unique
}

model Equipment {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  equipmentTypeId     Int

  name                String
  equipmentId         String
  serialNumber        String?

  location            String?
  department          String?

  status              EquipmentStatus       @default(ACTIVE)

  installedDate       DateTime?
  warrantyExpiry      DateTime?

  manufacturer        String?
  model               String?

  isActive            Boolean               @default(true)

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization        Organization          @relation(fields: [organizationId], references: [id])
  equipmentType       EquipmentType         @relation(fields: [equipmentTypeId], references: [id])

  @@index([organizationId])
  @@index([equipmentTypeId])
  @@unique(organizationId, equipmentId)
}

model ChecklistTemplate {
  id                    Int                 @id @default(autoincrement())
  organizationId        Int
  equipmentTypeId       Int

  name                  String
  description           String?

  organization          Organization        @relation(fields: [organizationId], references: [id])
  equipmentType         EquipmentType       @relation(fields: [equipmentTypeId], references: [id])

  items                 ChecklistItem[]
  schedules             PMSchedule[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizationId])
  @@index([equipmentTypeId])
}

model ChecklistItem {
  id                Int                     @id @default(autoincrement())
  templateId        Int

  name              String
  order             Int
  expectedValue     String?

  template          ChecklistTemplate       @relation(fields: [templateId], references: [id])

  createdAt         DateTime                @default(now())
}

model PMSchedule {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  equipmentId         Int
  templateId          Int

  frequencyType       FrequencyType
  interval            Int //Ex: every 7 days, every 2 weeks

  startDate           DateTime
  nextDueDate         DateTimeI

  assignedTo          Int

  isActive            Boolean               @default(true)

  organization        Organization          @relation(fields: [organizationId], references: [id])
  equipment           Equipment             @relation(fields: [equipmentId], references: [id])
  template            ChecklistTemplate     @relation(fields: [templateId], references: [id])
  assignee            User                  @relation(fields: [assignedTo], references: [id])

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([organizationId])
  @@index([equipmentId])
  @@index([nextDueDate])
}

// Task Job
model PMTask {
  id                      Int                     @id @default(autoincrement())
  organizationId          Int
  scheduleId              Int
  equipmentId             Int
  templateId              Int

  assignedTo              Int

  dueDate                 DateTime
  completedAt             DateTime?

  status                  TaskStatus              @default(PENDING)
  priority                TaskPriority            @default(MEDIUM)

  remarks                 String?

  organization            Organization            @relation(fields: [organizationId], references: [id])
  schedule                PMSchedule              @relation(fields: [scheduleId], references: [id])
  equipment               Equipment               @relation(fields: [equipmentId], references: [id])
  template                ChecklistTemplate       @relation(fields: [templateId], references: [id])
  assignee                User                    @relation(fields: [assignedTo], references: [id])

  checklistItems          TaskChecklistItem[]

  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([organizationId])
  @@index([scheduleId])
  @@dueDate([dueDate])
}

// Steps inside job
model TaskChecklistItem {
  id                Int           @id @default(autoincrement())
  taskId            Int

  name              String
  order             Int
  expectedValue     String?
  actualValue       String?
  status            ItemStatus?

  task              PMTask        @relation(fields: [taskId], references: [id])

  createdAt         DateTime      @default(now())

  @@index([taskId])
}

// Report the problem
model BreakdownReport {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  equipmentId         Int
  reportedBy          Int
  assignedTo          Int?

  title               String
  rootCause           String
  description         String?

  severity            BreakdownSeverity
  status              BreakdownStatus       @default(OPEN)

  reportedAt          DateTime              @default(now())
  resolvedAt          DateTime

  organization        Organization          @relation(fields: [organizationId], references: [id])
  equipment           Equipment             @relation(fields: [equipmentId], references: [id])
  reporter            User                  @relation("ReportedBy", fields: [reportedBy], references: [id])
  assignee            User?                 @relation("AssignedTo", fields: [assignedTo], references: [id])

  actions             BreakdownAction[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([organizationId])
  @@index([equipmentId])
  @@index([status])
}

// Steps taken to solve the problem
model BreakdownAction {
  id                Int                   @id @default(autoincrement())
  breakdownId       Int
  performedBy       Int

  action            String
  remarks           String?

  createdAt         DateTime              @default(now())

  breakdown         BreakdownReport       @relation(fields: [breakdownId], references: [id])
  user              User                  @relation(fields: [performedBy], references: [id])

  @@index([breakdownId])
}

model Notification {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  userId              Int

  type                NotificationType
  title               String
  message             String

  referenceId         Int? //taskId or breakdownId
  referenceType       ReferenceType?

  isRead              Boolean               @default(false)

  createdAt           DateTime              @default(now())
  readAt              DateTime?

  organization        Organization          @relation(fields: [organizationId], references: [id])
  user                User                  @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}