// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================

enum RoleType {
  ADMIN
  MANAGER
  ENGINEER
  TECHNICIAN
  INSPECTOR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LocationType {
  PLANT
  WAREHOUSE
  OFFICE
  FACILITY
  OTHERS
}

enum DepartmentType {
  MECHANICAL
  ELECTRICAL
  INSTRUMENTATION
  CIVIL
  OTHERS
}

enum IndustryType {
  MANUFACTURING
  CHEMICAL
  OIL_GAS
  FERTILIZER
  GENERAL
  OTHERS
}

enum CompanySize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  BREAKDOWN
  DECOMMISSIONED
}

enum FrequencyType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ItemStatus {
  PENDING
  OK
  NOT_OK
  SKIPPED
}

enum BreakdownSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreakdownStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  BREAKDOWN_RAISED
  BREAKDOWN_ASSIGNED
  BREAKDOWN_RESOLVED
}

enum ReferenceType {
  TASK
  BREAKDOWN
}

// ==============================
// AUTH MODULE
// ==============================

model User {
  id                      Int                 @id @default(autoincrement())
  organizationId          Int

  name                    String
  email                   String              @unique
  passwordHash            String
  isEmailVerified         Boolean             @default(false)
  isActive                Boolean             @default(true)
  lastLoginAt             DateTime?

  roles                   UserRole[]
  department              UserDepartment?
  emailVerifications      EmailVerification[]
  passwordResets          PasswordReset[]
  userSession             UserSession[]
  pmSchedules             PMSchedule[]
  pmTasks                 PMTask[]
  reportedBreakdowns      BreakdownReport[]   @relation("ReportedBy")
  assignedBreakdowns      BreakdownReport[]   @relation("AssignedTo")
  breakdownActions        BreakdownAction[]
  notifications           Notification[]

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  organization            Organization        @relation(fields: [organizationId], references: [id])

  @@index([organizationId]) //@@ means model level attribute. It applies to the table
}

model Role {
  id            Int           @id @default(autoincrement())
  name          RoleType      @unique

  users         UserRole[]
  invitations   Invitation[]
}

// It's a junction table between user <-> role
model UserRole {
  id        Int   @id @default(autoincrement())
  userId    Int
  roleId    Int

  user      User  @relation(fields: [userId], references: [id])
  role      Role  @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model UserSession {
  id                Int         @id @default(autoincrement())
  userId            Int         

  jti               String      @unique // A unique ID attached to each token so we can track and control it
  refreshToken      String      
  deviceInfo        String?
  ipAddress         String?
  userAgent         String?     // User agent is refer to the browser or app info, it can be used for security monitoring and analytics

  isActive          Boolean     @default(true)
  lastActiveAt      DateTime    @default(now())

  createdAt         DateTime    @default(now())
  expiresAt         DateTime

  user              User        @relation(fields: [userId], references: [id])
}

model EmailVerification {
  id          Int       @id @default(autoincrement())
  userId      Int       
  token       String    @unique
  expiresAt   DateTime
  isUsed      Boolean   @default(false)

  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id          Int         @id @default(autoincrement())
  userId      Int
  token       String      @unique
  expiresAt   DateTime
  isUsed      Boolean     @default(false)

  user        User        @relation(fields: [userId], references: [id])

  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id                Int                 @id @default(autoincrement())
  organizationId    Int             

  email             String
  roleId            Int 
  departmentId      Int?
  token             String              @unique
  status            InvitationStatus    @default(PENDING)
  expiresAt         DateTime

  role              Role                @relation(fields: [roleId], references: [id])
  department        Department?         @relation(fields: [departmentId], references:[id])
  organization      Organization        @relation(fields: [organizationId], references: [id])

  createdAt         DateTime            @default(now())

  @@unique([organizationId, email])
  @@index([email])
}

// ==============================
// ORGANIZATION MODULE
// ==============================

model Organization {
  id                  Int             @id @default(autoincrement())
  name                String
  slug                String          @unique //URL-Friendly unique identifier
  industryType        IndustryType?
  companySize         CompanySize?
  country             String?
  city                String?
  logoUrl             String?
  logoPublicId        String?
  isActive            Boolean         @default(true)

  users               User[]
  locations           Location[]
  departments         Department[]
  invitations         Invitation[]
  equipmentTypes      EquipmentType[]
  equipments          Equipment[]
  checklistTemplates  ChecklistTemplate[]
  pmSchedules         PMSchedule[]
  pmTasks             PMTask[]
  breakdownReports    BreakdownReport[]
  notifications       Notification[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Location {
  id                Int           @id @default(autoincrement())
  organizationId    Int

  name              String
  type              LocationType?
  address           String

  equipment         Equipment[]

  createdAt         DateTime      @default(now())
  
  organization      Organization  @relation(fields: [organizationId], references: [id])
}

model Department {
  id                Int             @id @default(autoincrement())
  organizationId    Int             

  name              String
  code              String
  type              DepartmentType

  users             UserDepartment[]
  invitations       Invitation[]
  equipment         Equipment[]
  
  createdAt         DateTime        @default(now())
  organization      Organization    @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@unique([organizationId, code])
}

model UserDepartment {
  id              Int         @id @default(autoincrement())
  userId          Int         @unique // The unique refer that one user have one department
  departmentId    Int

  user            User        @relation(fields: [userId], references: [id])
  department      Department  @relation(fields: [departmentId], references: [id])
}

// ==============================
// EQUIPMENT MODULE
// ==============================

model EquipmentType {
  id                    Int             @id @default(autoincrement())
  organizationId        Int

  name                  String
  code                  String?      
  description           String?

  isActive              Boolean         @default(true)

  equipments            Equipment[]
  checklistTemplates    ChecklistTemplate[]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organization          Organization    @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name]) // Inside one organization type name is unique
  @@unique([organizationId, code])
}

model Equipment {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  equipmentTypeId     Int

  name                String
  code                String
  serialNumber        String?

  locationId          Int?
  departmentId        Int?

  status              EquipmentStatus       @default(ACTIVE)

  installedDate       DateTime?
  warrantyExpiry      DateTime?

  manufacturer        String?
  model               String?

  pmSchedules         PMSchedule[]
  pmTasks             PMTask[]
  breakdownReports    BreakdownReport[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization        Organization          @relation(fields: [organizationId], references: [id])
  equipmentType       EquipmentType         @relation(fields: [equipmentTypeId], references: [id])
  department          Department?           @relation(fields: [departmentId], references: [id])
  location            Location?             @relation(fields: [locationId], references: [id])

  @@index([organizationId])
  @@index([equipmentTypeId])
  @@unique([organizationId, code])
}

// ==============================
// CHECKLIST MODULE
// ==============================

model ChecklistTemplate {
  id                    Int                 @id @default(autoincrement())
  organizationId        Int
  equipmentTypeId       Int

  name                  String
  description           String?

  organization          Organization        @relation(fields: [organizationId], references: [id])
  equipmentType         EquipmentType       @relation(fields: [equipmentTypeId], references: [id])

  items                 ChecklistItem[]
  schedules             PMSchedule[]
  tasks                 PMTask[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizationId])
  @@index([equipmentTypeId])
}

model ChecklistItem {
  id                Int                     @id @default(autoincrement())
  templateId        Int

  name              String
  order             Int
  expectedValue     String?

  template          ChecklistTemplate       @relation(fields: [templateId], references: [id])

  createdAt         DateTime                @default(now())
}

// ==============================
// PM (PREVENTIVE MAINTENANCE)
// ==============================

model PMSchedule {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  equipmentId         Int
  templateId          Int

  frequencyType       FrequencyType
  interval            Int //Ex: every 7 days, every 2 weeks

  startDate           DateTime
  nextDueDate         DateTime

  assignedTo          Int

  isActive            Boolean               @default(true)

  pmTasks             PMTask[]

  organization        Organization          @relation(fields: [organizationId], references: [id])
  equipment           Equipment             @relation(fields: [equipmentId], references: [id])
  template            ChecklistTemplate     @relation(fields: [templateId], references: [id])
  assignee            User                  @relation(fields: [assignedTo], references: [id])

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([organizationId])
  @@index([equipmentId])
  @@index([nextDueDate])
  @@index([assignedTo])
}

// Task Job
model PMTask {
  id                      Int                     @id @default(autoincrement())
  organizationId          Int
  scheduleId              Int
  equipmentId             Int
  templateId              Int

  assignedTo              Int

  dueDate                 DateTime
  completedAt             DateTime?

  status                  TaskStatus              @default(PENDING)
  priority                TaskPriority            @default(MEDIUM)

  remarks                 String?

  organization            Organization            @relation(fields: [organizationId], references: [id])
  schedule                PMSchedule              @relation(fields: [scheduleId], references: [id])
  equipment               Equipment               @relation(fields: [equipmentId], references: [id])
  template                ChecklistTemplate       @relation(fields: [templateId], references: [id])
  assignee                User                    @relation(fields: [assignedTo], references: [id])
  
  checklistItems          TaskChecklistItem[]

  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([organizationId])
  @@index([scheduleId])
  @@index([dueDate])
  @@index([assignedTo])
}

// Steps inside job
model TaskChecklistItem {
  id                Int           @id @default(autoincrement())
  taskId            Int

  name              String
  order             Int
  expectedValue     String?
  actualValue       String?
  status            ItemStatus?

  task              PMTask        @relation(fields: [taskId], references: [id])

  createdAt         DateTime      @default(now())

  @@index([taskId])
}

// ==============================
// BREAKDOWN MODULE
// ==============================

// Report the problem
model BreakdownReport {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  equipmentId         Int
  reportedBy          Int
  assignedTo          Int?

  title               String
  rootCause           String
  description         String?

  severity            BreakdownSeverity
  status              BreakdownStatus       @default(OPEN)

  reportedAt          DateTime              @default(now())
  resolvedAt          DateTime?

  organization        Organization          @relation(fields: [organizationId], references: [id])
  equipment           Equipment             @relation(fields: [equipmentId], references: [id])
  reporter            User                  @relation("ReportedBy", fields: [reportedBy], references: [id])
  assignee            User?                 @relation("AssignedTo", fields: [assignedTo], references: [id])

  actions             BreakdownAction[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([organizationId])
  @@index([equipmentId])
  @@index([status])
  @@index([assignedTo])
}

// Steps taken to solve the problem
model BreakdownAction {
  id                Int                   @id @default(autoincrement())
  breakdownId       Int
  performedBy       Int

  action            String
  remarks           String?

  createdAt         DateTime              @default(now())

  breakdown         BreakdownReport       @relation(fields: [breakdownId], references: [id])
  user              User                  @relation(fields: [performedBy], references: [id])

  @@index([breakdownId])
}

// ==============================
// NOTIFICATION MODULE
// ==============================

model Notification {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  userId              Int

  type                NotificationType
  title               String
  message             String

  referenceId         Int? //taskId or breakdownId
  referenceType       ReferenceType?

  isRead              Boolean               @default(false)

  createdAt           DateTime              @default(now())
  readAt              DateTime?

  organization        Organization          @relation(fields: [organizationId], references: [id])
  user                User                  @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ==============================
// LOGGING
// ==============================

model AuditLog {
  id                Int       @id @default(autoincrement())
  organizationId    Int
  userId            Int

  action            String
  module            String
  recordId          String
  ipAddress         String?

  createdAt         DateTime  @default(now())
}